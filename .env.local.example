# Vercel AI Gateway — single API key for all model providers
# (OpenAI, Anthropic, Google, etc). Get yours at:
# https://vercel.com/[your-team]/~/ai-gateway/api-keys
#
# When deployed on Vercel, this is auto-provided via OIDC tokens
# and you don't need to set this env var at all.
AI_GATEWAY_API_KEY=vck_...

# Supabase — provisioned via Vercel Marketplace.
# Service role key is server-side only (never exposed to client).
# Get yours at:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
