# Vercel AI Gateway — single API key for all model providers
# (OpenAI, Anthropic, Google, etc). Get yours at:
# https://vercel.com/[your-team]/~/ai-gateway/api-keys
#
# When deployed on Vercel, this is auto-provided via OIDC tokens
# and you don't need to set this env var at all.
AI_GATEWAY_API_KEY=vck_...

# Supabase — provisioned via Vercel Marketplace.
# Service role key is server-side only (never exposed to client).
# Get yours at:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Upstash Redis — per-IP rate limiting on /api/chat.
# Provisioned via the Vercel Marketplace (auto-injected on deploy).
# Local dev: `vercel link` + `vercel env pull` populates these,
# or grab the REST credentials from your Upstash console.
KV_REST_API_URL=https://your-project.upstash.io
KV_REST_API_TOKEN=...

# Optional feature flags
# RETRIEVAL_MODE=hybrid  # "hybrid" (default) or "vector" — flips
#                          retrieval between vector-only and vector+FTS
#                          merged via Reciprocal Rank Fusion.
# QUERY_REWRITE=on       # "on" (default) or "off" — toggles the
#                          multi-turn query condensation step. Off
#                          means follow-ups like "what about email?"
#                          search verbatim instead of being rewritten.
